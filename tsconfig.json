{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // Astro components pass `undefined` to optional props throughout.
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
