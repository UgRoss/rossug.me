---
import Layout from './Layout.astro';
import ArticleHeader from '../components/ArticleHeader.astro';

interface Props {
	title: string;
	category: string;
	pubDate: Date;
	updateDate?: Date;
	excerpt?: string;
}

const { title, category, pubDate, updateDate, excerpt } = Astro.props;
---

<Layout title={title} description={excerpt ?? title}>
	<main class="w-full px-5 pt-16 pb-20">
		<div class="note-container mx-auto max-w-150">
			<article>
				<ArticleHeader
					title={title}
					date={pubDate}
					updated={updateDate}
					labels={[category]}
				/>
				<div class="prose prose-sm rich-text">
					<slot />
				</div>
			</article>
		</div>
	</main>
</Layout>
