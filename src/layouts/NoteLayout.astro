---
import ArticleHeader from '@/components/ArticleHeader.astro';
import PageShell from '@/components/PageShell.astro';

import Layout from './Layout.astro';

interface Props {
	category: string;
	description?: string;
	pubDate: Date;
	title: string;
	updateDate?: Date;
}

const { category, description, pubDate, title, updateDate } = Astro.props;
---

<Layout
	description={description ?? title}
	publishedTime={pubDate}
	title={title}
	type="article"
>
	<PageShell>
		<article>
			<ArticleHeader
				date={pubDate}
				labels={[category]}
				title={title}
				updated={updateDate}
			/>
			<div class="prose prose-sm rich-text">
				<slot />
			</div>
		</article>
	</PageShell>
</Layout>
