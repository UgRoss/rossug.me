---
import Layout from './Layout.astro';
import PageShell from '@/components/PageShell.astro';
import ArticleHeader from '@/components/ArticleHeader.astro';

interface Props {
	title: string;
	category: string;
	pubDate: Date;
	updateDate?: Date;
	description?: string;
}

const { title, category, pubDate, updateDate, description } = Astro.props;
---

<Layout
	title={title}
	description={description ?? title}
	type="article"
	publishedTime={pubDate}
>
	<PageShell>
		<article>
			<ArticleHeader
				title={title}
				date={pubDate}
				updated={updateDate}
				labels={[category]}
			/>
			<div class="prose prose-sm rich-text">
				<slot />
			</div>
		</article>
	</PageShell>
</Layout>
