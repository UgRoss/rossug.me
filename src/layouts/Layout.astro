---
import '@/styles/global.css';
import type { PageMeta } from '@/types';

import BaseHead from '@/components/BaseHead.astro';
import Nav from '@/components/Nav.astro';
import { THEME_STORAGE_KEY } from '@/utils/theme';

// Theme contract: <html data-theme> is set only once a visitor has chosen a
// theme (ThemeToggle stores it under THEME_STORAGE_KEY). Without it,
// global.css follows the system through `color-scheme: light dark`. The
// inline script below applies a stored choice before first paint so the page
// never flashes the wrong theme.
type Props = PageMeta;

const meta = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead {...meta} />
		<script define:vars={{ storageKey: THEME_STORAGE_KEY }} is:inline>
			try {
				const chosen = localStorage.getItem(storageKey);
				if (chosen === 'light' || chosen === 'dark') {
					document.documentElement.dataset.theme = chosen;
				}
			} catch {
				// localStorage may be unavailable (e.g. disabled or private browsing); ignore and follow the system theme.
			}
		</script>
	</head>
	<body class="bg-page text-ink font-sans text-body font-normal antialiased">
		<Nav />
		<slot />
	</body>
</html>
