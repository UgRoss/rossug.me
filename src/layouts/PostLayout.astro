---
import type { ImageMetadata, MarkdownHeading } from 'astro';

import { Image } from 'astro:assets';

import ArticleHeader from '@/components/ArticleHeader.astro';
import PageShell from '@/components/PageShell.astro';
import TableOfContents from '@/components/TableOfContents.astro';

import Layout from './Layout.astro';

interface Props {
	date: Date;
	description: string;
	headings: MarkdownHeading[];
	image?: ImageMetadata;
	tags?: string[];
	title: string;
}

const { date, description, headings, image, tags, title } = Astro.props;
---

<Layout
	description={description}
	image={image}
	publishedTime={date}
	title={title}
	type="article"
>
	<PageShell>
		<article>
			{image && (
				<Image
					alt=""
					class="mb-10 block h-auto w-full"
					priority
					src={image}
					width={1120}
				/>
			)}
			<!-- The TOC is anchored to the top of the title block, not the
			     viewport, so it lines up with the title however tall the hero
			     image is. Its box spans the title and body and the nav inside
			     sticks while scrolling. It sits one gutter (4rem) left of the
			     600px column, nudged down so its label shares a line with the
			     title's first line, and hides below 1240px, the width where
			     that still leaves a 36px margin from the window edge. -->
			<div class="relative">
				<aside class="absolute top-3 bottom-0 right-[calc(100%+4rem)] hidden w-[220px] min-[1240px]:block">
					<div class="sticky top-24">
						<TableOfContents headings={headings} />
					</div>
				</aside>
				<ArticleHeader date={date} labels={tags} title={title} />
				<div class="prose prose-sm rich-text">
					<slot />
				</div>
			</div>
		</article>
	</PageShell>
</Layout>
