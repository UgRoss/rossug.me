---
import Layout from './Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import TableOfContents from '../components/TableOfContents.astro';
import BackLink from '../components/BackLink.astro';
import { readingTime } from '../utils/reading-time';
import { postDateFormatter, type Heading } from '../utils/posts';

interface Props {
	title: string;
	description: string;
	date: Date;
	body: string;
	headings: Heading[];
}

const { title, description, date, body, headings } = Astro.props;
---

<Layout title={title} description={description}>
	<main class="post-page">
		<ThemeToggle />
		<aside class="post-toc">
			<TableOfContents headings={headings} />
		</aside>
		<div class="post-container">
			<BackLink />
			<article class="post-content">
				<h1>{title}</h1>
				<p class="post-byline">
					{postDateFormatter.format(date)} · {readingTime(body)}
				</p>
				<div class="prose prose-sm rich-text">
					<slot />
				</div>
			</article>
		</div>
	</main>
</Layout>

<style>
	.post-page {
		width: 100%;
		padding: 64px 0 80px;
	}

	.post-container {
		width: calc(100% - 40px);
		max-width: 560px;
		margin: 0 auto;
	}

	.post-container :global(.back-link) {
		margin-bottom: 24px;
	}

	.post-toc {
		display: none;
	}

	@media (min-width: 1280px) {
		.post-toc {
			display: block;
			position: fixed;
			top: 96px;
			left: max(20px, calc(50% - 280px - 32px - 220px));
			width: 220px;
		}
	}

	.post-content h1 {
		margin: 0 0 8px;
		font-size: 22px;
		font-weight: 600;
		line-height: 30px;
		color: var(--color-ink-strong);
	}

	.post-byline {
		margin: 0 0 24px;
		font-size: 12.5px;
		line-height: 18px;
		color: var(--color-ink-muted);
	}
</style>
