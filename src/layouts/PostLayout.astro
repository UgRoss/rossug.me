---
import Layout from './Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import TableOfContents from '../components/TableOfContents.astro';
import BackLink from '../components/BackLink.astro';
import { readingTime } from '../utils/reading-time';
import { postDateFormatter, type Heading } from '../utils/posts';

interface Props {
	title: string;
	description: string;
	date: Date;
	body: string;
	headings: Heading[];
}

const { title, description, date, body, headings } = Astro.props;
---

<Layout title={title} description={description}>
	<main class="w-full px-5 pt-16 pb-20">
		<ThemeToggle />
		<aside class="post-toc">
			<TableOfContents headings={headings} />
		</aside>
		<div class="post-container mx-auto max-w-140">
			<BackLink />
			<article>
				<h1 class="text-heading-lg m-0 mb-2 text-ink-strong">{title}</h1>
				<p class="text-meta m-0 mb-6 text-ink-muted">
					{postDateFormatter.format(date)} · {readingTime(body)}
				</p>
				<div class="prose prose-sm rich-text">
					<slot />
				</div>
			</article>
		</div>
	</main>
</Layout>

<style>
	/* Left unconverted for now: bespoke fixed-position math tied to a
	   specific viewport-center calculation, and a contextual spacing
	   override on a shared child component's root class — neither maps
	   cleanly onto a utility class. */
	.post-container :global(.back-link) {
		margin-bottom: 24px;
	}

	.post-toc {
		display: none;
	}

	@media (min-width: 1280px) {
		.post-toc {
			display: block;
			position: fixed;
			top: 96px;
			left: max(20px, calc(50% - 280px - 32px - 220px));
			width: 220px;
		}
	}
</style>
