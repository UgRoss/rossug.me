---
interface Props {
	locale: string;
	mark: string;
	timeZone: string;
}

const { locale, mark, timeZone } = Astro.props;
---

<footer
	class="appear text-small w-full px-5 pt-6 pb-12 text-ink-muted"
	style="--appear-delay: 250ms"
>
	<div class="mx-auto flex max-w-150 items-center justify-between gap-3">
		<span class="inline-flex items-center gap-1.5 text-[10px] whitespace-nowrap tracking-[0.02em]">
			<span>{locale}</span>
			<span class="tabular-nums" id="footer-time"></span>
		</span>
		<span aria-hidden="true" class="text-[16px] text-ink-strong">
			{mark}
		</span>
	</div>
</footer>

<script define:vars={{ timeZone }} is:inline>
	function updateClock() {
		const el = document.getElementById('footer-time');
		if (!el) return;

		const formatter = new Intl.DateTimeFormat('en-GB', {
			hour: '2-digit',
			minute: '2-digit',
			timeZone,
		});

		el.textContent = formatter.format(new Date());
	}

	updateClock();
	setInterval(updateClock, 1000 * 30);
</script>
