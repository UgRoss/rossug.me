---
interface Props {
	locale: string;
	timeZone: string;
	mark: string;
}

const { locale, timeZone, mark } = Astro.props;
---

<footer
	class="appear text-small mx-auto max-w-140 px-5 pt-6 pb-12 text-ink-muted"
	style="--appear-delay: 250ms"
>
	<div class="flex items-center justify-between gap-3">
		<span class="inline-flex items-center gap-1.5 text-[10px] whitespace-nowrap tracking-[0.02em]">
			<span>{locale}</span>
			<span class="tabular-nums" id="footer-time"></span>
		</span>
		<span class="text-[16px] text-ink-strong" aria-hidden="true">
			{mark}
		</span>
	</div>
</footer>

<script is:inline define:vars={{ timeZone }}>
	function updateClock() {
		const el = document.getElementById('footer-time');
		if (!el) return;

		const formatter = new Intl.DateTimeFormat('en-GB', {
			hour: '2-digit',
			minute: '2-digit',
			timeZone,
		});

		el.textContent = formatter.format(new Date());
	}

	updateClock();
	setInterval(updateClock, 1000 * 30);
</script>
