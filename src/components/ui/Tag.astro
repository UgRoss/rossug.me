---
interface Props {
  href?: string
  interactive?: boolean
  label: string
  selected?: boolean
}

const { href, interactive = true, label, selected = false } = Astro.props

const classes = `tag ${interactive ? 'tag-interactive focus-ring' : ''} ${selected ? 'tag-selected' : ''}`
---

{
  href ? (
    <a class={classes} href={href}>
      {label}
    </a>
  ) : (
    <span class={classes}>{label}</span>
  )
}
