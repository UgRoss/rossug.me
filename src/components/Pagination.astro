---
import ArrowIcon from './ArrowIcon';
import Button from './Button';

interface Props {
	nextUrl?: string;
	prevUrl?: string;
}

const { nextUrl, prevUrl } = Astro.props;
---

{(prevUrl || nextUrl) && (
	<nav
		aria-label="Posts pagination"
		class="text-body flex w-full items-center justify-between"
	>
		<div>
			{prevUrl && (
				<Button href={prevUrl} icon={<ArrowIcon direction="left" />}>
					Newer posts
				</Button>
			)}
		</div>
		<div>
			{nextUrl && (
				<Button
					href={nextUrl}
					icon={<ArrowIcon direction="right" />}
					iconPosition="after"
				>
					Older posts
				</Button>
			)}
		</div>
	</nav>
)}
