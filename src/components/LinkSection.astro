---
import type { LinkItem } from '../types';
import LinkList from './LinkList.astro';

interface Props {
	title: string;
	items: LinkItem[];
}

const { title, items } = Astro.props;
const headingId = `${title.toLowerCase().replace(/\s+/g, '-')}-title`;
---

<section
	class="appear flex w-full flex-col items-start gap-3.5"
	style="--appear-delay: 180ms"
	aria-labelledby={headingId}
>
	<h2 id={headingId} class="text-body m-0 font-normal text-ink-muted">
		{title}
	</h2>
	<LinkList items={items} />
</section>
