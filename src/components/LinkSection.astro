---
import type { LinkItem } from '@/types';

import { headingId } from '@/utils/ids';

import LinkList from './LinkList.astro';

interface Props {
	items: LinkItem[];
	title: string;
}

const { items, title } = Astro.props;
const titleId = headingId(title);
---

<section
	aria-labelledby={titleId}
	class="appear flex w-full flex-col items-start gap-3.5"
	style="--appear-delay: 180ms"
>
	<h2 class="text-body m-0 font-normal text-ink-muted" id={titleId}>
		{title}
	</h2>
	<LinkList items={items} />
</section>
