---
import Divider from './Divider.astro';
import CopyButton from './CopyButton.astro';

interface Props {
	heading: string;
	paragraphs: string[];
	email: string;
}

const { heading, paragraphs, email } = Astro.props;
---

<Divider />
<section
	class="rich-text appear flex w-full flex-col items-start gap-3.5"
	style="--appear-delay: 215ms"
	aria-labelledby="connect-title"
>
	<h2 id="connect-title" class="text-body m-0 font-normal text-ink-muted">
		{heading}
	</h2>
	<div class="text-body flex w-full flex-col gap-2.5 text-ink">
		{paragraphs.map((text) => (
			<p class="m-0 wrap-anywhere">{text}</p>
		))}
		<p class="m-0 wrap-anywhere">
			Email me at <a href={`mailto:${email}`}>{email}</a>
			<CopyButton value={email} label={`Copy ${email}`} />
		</p>
	</div>
</section>
