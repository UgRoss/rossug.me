---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter(
	(heading) => heading.depth === 2 || heading.depth === 3,
);
---

{items.length > 0 && (
	<nav class="rich-text flex flex-col gap-2" aria-label="Table of contents">
		<p class="text-meta m-0 font-semibold text-ink-muted">On this page</p>
		<ul class="m-0 flex list-none flex-col gap-1.5 p-0">
			{items.map((item) => (
				<li class="text-body" class:list={{ 'pl-3': item.depth === 3 }}>
					<a href={`#${item.slug}`}>{item.text}</a>
				</li>
			))}
		</ul>
	</nav>
)}
