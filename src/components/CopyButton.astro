---
interface Props {
	value: string;
	label: string;
}

const { value, label } = Astro.props;
---

<button
	type="button"
	class="ml-5 inline-flex cursor-pointer items-center justify-center border-none bg-transparent p-0 align-[-2px] text-ink-muted transition-colors duration-[160ms] hover:text-ink-strong focus-visible:text-ink-strong"
	data-copy-value={value}
	aria-label={label}
>
	<svg
		viewBox="0 0 24 24"
		width="14"
		height="14"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
		<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
	</svg>
</button>

<script>
	document
		.querySelectorAll<HTMLButtonElement>('[data-copy-value]')
		.forEach((button) => {
			const value = button.dataset.copyValue;
			if (!value) return;

			if (!navigator.clipboard) {
				button.hidden = true;
				return;
			}

			button.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(value);
				} catch {
					// clipboard write can fail silently (e.g. unfocused document); nothing to do here
				}
			});
		});
</script>
