---
import type { BioParagraph } from '../data/site';

interface Props {
	paragraphs: BioParagraph[];
}

const { paragraphs } = Astro.props;
---

<div class="information rich-text">
	{paragraphs.map((p, i) => (
		<p
			class="appear"
			style={`--appear-delay: ${75 + i * 35}ms`}
			set:html={p.html}
		/>
	))}
</div>

<style>
	.information {
		display: flex;
		flex-direction: column;
		gap: 10px;
		width: 100%;
	}

	.information p {
		margin: 0;
		width: 100%;
		font-size: 14px;
		line-height: 22px;
		color: var(--color-ink);
		overflow-wrap: anywhere;
	}
</style>
