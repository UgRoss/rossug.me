---
import type { GetStaticPaths } from 'astro';
import Layout from '@/layouts/Layout.astro';
import PageShell from '@/components/PageShell.astro';
import PageHeader from '@/components/PageHeader.astro';
import LinkList from '@/components/LinkList.astro';
import Pagination from '@/components/Pagination.astro';
import { getSortedPosts, postToLinkItem } from '@/utils/posts';

export const getStaticPaths = (async ({ paginate }) => {
	const PAGE_SIZE = 10;
	const posts = await getSortedPosts();
	return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const description = 'Posts on frontend engineering, React, and TypeScript.';

const items = page.data.map(postToLinkItem);
---

<Layout title="Blog" description={description}>
	<PageShell stack>
		<PageHeader title="Blog" description={description} />
		{items.length === 0 ? (
			<p class="text-body m-0 text-ink-muted">No posts yet.</p>
		) : (
			<LinkList items={items} />
		)}
		<Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
	</PageShell>
</Layout>
