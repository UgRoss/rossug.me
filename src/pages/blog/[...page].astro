---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import LinkList from '../../components/LinkList.astro';
import Pagination from '../../components/Pagination.astro';
import { format } from 'date-fns';
import { getSortedPosts } from '../../utils/posts';

export const getStaticPaths = (async ({ paginate }) => {
	const PAGE_SIZE = 10;
	const posts = await getSortedPosts();
	return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const description = 'Posts on frontend engineering, React, and TypeScript.';

const items = page.data.map((post) => ({
	name: post.data.title,
	href: `/blog/${post.id}/`,
	meta: format(post.data.date, 'MMM d, yyyy'),
}));

// paginate() omits the trailing slash the rest of the site uses (post
// links, RSS); add it back so pagination links match that convention.
const withTrailingSlash = (url: string | undefined) =>
	url && !url.endsWith('/') ? `${url}/` : url;
---

<Layout title="Blog" description={description}>
	<main class="w-full px-5 pt-16 pb-20">
		<div class="mx-auto flex max-w-150 flex-col items-start gap-6.5">
			<PageHeader title="Blog" description={description} />
			{items.length === 0 ? (
				<p class="text-body m-0 text-ink-muted">No posts yet.</p>
			) : (
				<LinkList items={items} />
			)}
			<Pagination
				prevUrl={withTrailingSlash(page.url.prev)}
				nextUrl={withTrailingSlash(page.url.next)}
			/>
		</div>
	</main>
</Layout>
