---
import { Image } from 'astro:assets';

import workspace from '@/assets/workspace.png';
import PageHeader from '@/components/PageHeader.astro';
import PageShell from '@/components/PageShell.astro';
import { usesIntro, usesSections } from '@/data/uses';
import Layout from '@/layouts/Layout.astro';
import { headingId } from '@/utils/ids';

const description = usesIntro;
---

<Layout description={description} title="Uses">
	<PageShell stack>
		<PageHeader description={description} title="Uses" />
		<Image
			alt="My desk: a laptop and monitor under a window, with a lamp and a plant."
			class="mb-6 block h-auto w-full"
			priority
			src={workspace}
			width={1120}
		/>
		<div class="rich-text flex w-full flex-col gap-12">
			{usesSections.map((section) => (
				<section
					aria-labelledby={headingId(section.title)}
					class="flex flex-col gap-4"
				>
					<h2
						class="text-heading-lg m-0 text-ink-strong"
						id={headingId(section.title)}
					>
						{section.title}
					</h2>
					<ul class="m-0 flex list-none flex-col gap-3 p-0">
						{section.items.map((item) => (
							<li class="flex flex-col gap-0.5">
								<span class="text-body font-medium text-ink-strong">
									{item.href ? (
										<a
											href={item.href}
											rel="noopener noreferrer"
											target="_blank"
										>
											{item.name}
										</a>
									) : (
										item.name
									)}
								</span>
								<span class="text-body text-ink-muted">{item.note}</span>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
	</PageShell>
</Layout>
