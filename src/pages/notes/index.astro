---
import Layout from '../../layouts/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import TilBrowser from '../../components/TilBrowser';
import { getSortedNotes, type NoteSummary } from '../../utils/notes';

const notes = await getSortedNotes();

const summaries: NoteSummary[] = notes.map((note) => ({
	slug: note.id,
	title: note.data.title,
	category: note.data.category,
	excerpt: note.data.excerpt,
	pubDate: note.data.pubDate.toISOString(),
}));
---

<Layout title="Notes" description="Quick things I've learned.">
	<main class="w-full px-5 pt-16 pb-20">
		<div class="mx-auto flex max-w-140 flex-col items-start gap-6.5">
			<ThemeToggle />
			<h1 class="text-xl m-0 font-semibold text-ink-strong">Today I Learned</h1>
			<TilBrowser client:load notes={summaries} />
		</div>
	</main>
</Layout>
