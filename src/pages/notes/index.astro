---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import NoteBrowser from '../../components/NoteBrowser';
import { getSortedNotes, type NoteSummary } from '../../utils/notes';

const description = "Quick things I've learned.";
const notes = await getSortedNotes();

const summaries: NoteSummary[] = notes.map((note) => ({
	slug: note.id,
	title: note.data.title,
	category: note.data.category,
	excerpt: note.data.excerpt,
	pubDate: note.data.pubDate.toISOString(),
}));
---

<Layout title="Notes" description={description}>
	<main class="w-full px-5 pt-16 pb-20">
		<div class="mx-auto flex max-w-150 flex-col items-start gap-6.5">
			<PageHeader title="Today I Learned" description={description} />
			<NoteBrowser client:load notes={summaries} />
		</div>
	</main>
</Layout>
