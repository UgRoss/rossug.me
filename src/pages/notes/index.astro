---
import type { NoteSummary } from '@/types';

import NoteBrowser from '@/components/NoteBrowser';
import PageHeader from '@/components/PageHeader.astro';
import PageShell from '@/components/PageShell.astro';
import Layout from '@/layouts/Layout.astro';
import { getSortedNotes } from '@/utils/notes';

const description = "Quick things I've learned.";
const notes = await getSortedNotes();

const summaries: NoteSummary[] = notes.map((note) => ({
	category: note.data.category,
	description: note.data.description,
	pubDate: note.data.pubDate.toISOString(),
	slug: note.id,
	title: note.data.title,
}));
---

<Layout description={description} title="Today I Learned">
	<PageShell stack>
		<PageHeader description={description} title="Today I Learned" />
		<NoteBrowser client:load notes={summaries} />
	</PageShell>
</Layout>
