---
import PageHeader from '@/components/PageHeader.astro';
import PageShell from '@/components/PageShell.astro';
import Layout from '@/layouts/Layout.astro';

const description = "The page you're looking for doesn't exist.";
---

<Layout description={description} noindex title="Page not found">
	<PageShell stack>
		<PageHeader description={description} title="Page not found" />
	</PageShell>
</Layout>
