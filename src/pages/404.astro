---
import Layout from '@/layouts/Layout.astro';
import PageShell from '@/components/PageShell.astro';
import PageHeader from '@/components/PageHeader.astro';

const description = "The page you're looking for doesn't exist.";
---

<Layout title="Page not found" description={description} noindex>
	<PageShell stack>
		<PageHeader title="Page not found" description={description} />
	</PageShell>
</Layout>
