---
import { getEntry, render } from 'astro:content';

import Avatar from '@/components/Avatar.astro';
import Bio from '@/components/Bio.astro';
import Footer from '@/components/Footer.astro';
import Greeting from '@/components/Greeting.astro';
import LinkSection from '@/components/LinkSection.astro';
import { avatar, footer, greetings, siteMeta } from '@/data/site';
import Layout from '@/layouts/Layout.astro';
import { getSortedPosts, postToLinkItem } from '@/utils/posts';

const posts = await getSortedPosts();

const about = await getEntry('about', 'index');
if (!about) throw new Error('Missing content entry: about/index.md');
const { Content: AboutContent } = await render(about);

const blogItems = posts.map(postToLinkItem);
---

<Layout description={siteMeta.description} title={siteMeta.title}>
	<main class="w-full min-w-80">
		<section class="w-full px-5 pt-16 pb-12">
			<div class="mx-auto flex max-w-150 flex-col items-start gap-6.5">
				<h1 class="sr-only">{siteMeta.title}</h1>
				<Avatar initials={avatar.initials} />
				<div class="flex w-full flex-col items-start gap-9">
					<div class="flex w-full flex-col items-start gap-3">
						<Greeting items={greetings} />
						<Bio>
							<AboutContent />
						</Bio>
					</div>
					<div class="flex w-full flex-col items-start gap-1">
						<LinkSection items={blogItems} title="Posts" />
					</div>
				</div>
			</div>
		</section>
		<Footer
			locale={footer.locale}
			mark={footer.mark}
			timeZone={footer.timeZone}
		/>
	</main>
</Layout>
